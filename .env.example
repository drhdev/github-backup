# Deployment target: Ubuntu 24.04+ x86_64; compose.yaml fixes linux/amd64.
# Required values must be available to Coolify Compose build-time interpolation AND runtime.
# REQUIRED: fill these six values. They intentionally have no fake working defaults.
# GitHub Settings > Developer settings > GitHub Apps > your App > General: App ID.
GITHUB_APP_ID=
# Account/org login names from github.com/NAME; install the App on All repositories for each.
GITHUB_APP_OWNERS=
# App General > Private keys > Generate a private key; download the PEM.
# Encode locally: base64 < app-private-key.pem | tr -d '\n'
# Use that single-line output below; treat it as a secret.
GITHUB_APP_PRIVATE_KEY_BASE64=
# DigitalOcean > Spaces Object Storage > Access Keys > Create Access Key.
# AWS_ names are boto3/S3 conventions: enter DIGITALOCEAN values; no AWS account needed.
# Access key ID (not friendly name), then the matching secret saved at creation.
# Neither value is a DigitalOcean personal API token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DigitalOcean > Spaces Object Storage > Buckets: copy the destination bucket name only.
# It may contain other applications' files outside SPACES_PREFIX/.
SPACES_BUCKET=

# OPTIONAL: working defaults; get the region from your bucket's Spaces settings/origin hostname.
# company-files.ams3.digitaloceanspaces.com means bucket=company-files, region=ams3.
SPACES_REGION=fra1
# Reserve this folder exclusively for this worker. Nested prefixes are allowed.
SPACES_PREFIX=github-backup
BACKUP_INTERVAL_HOURS=1
# Recent changed versions plus older UTC calendar checkpoints; deduplicated.
BACKUP_RETENTION=3
BACKUP_KEEP_WEEKLY=2
BACKUP_KEEP_MONTHLY=2
BACKUP_KEEP_OLDEST=true
# 0 disables the age floor to keep the above count policy bounded.
BACKUP_MIN_AGE_DAYS=0
BACKUP_MANIFEST_RETENTION=14
# Budget counts only live objects inside SPACES_PREFIX/, not the shared bucket.
BACKUP_MAX_STORAGE_GIB=100
BACKUP_WORKERS=1
BACKUP_TIMEOUT_HOURS=12
BACKUP_CPUS=0.5
BACKUP_MEMORY_LIMIT=512m
# Optional comma-separated numeric IDs of intentionally deleted repos; never purges data.
ACKNOWLEDGED_MISSING_REPOSITORIES=

# OPTIONAL: disabled when empty. Copy a Push monitor's secret URL from Uptime Kuma.
UPTIME_KUMA_PUSH_URL=
# Enable only for Kuma reached over a trusted private HTTP network.
UPTIME_KUMA_ALLOW_HTTP=false
UPTIME_KUMA_TIMEOUT_SECONDS=5
# 0 = automatic: 2 * BACKUP_INTERVAL_HOURS + 1 (3 hours with default hourly checks).
UPTIME_KUMA_MAX_SUCCESS_AGE_HOURS=0
