# Deployment target: Ubuntu 24.04+ x86_64; compose.yaml fixes linux/amd64.
# Required values must be available to Coolify Compose build-time interpolation AND runtime.
# Automatic GitHub App setup (default): no App ID, PEM, or Base64 to copy.
# REQUIRED for browser setup: the exact HTTPS origin assigned to github-setup in Coolify.
# Example: https://github-backup.example.com (no path, no trailing slash).
GITHUB_SETUP_URL=
# REQUIRED for browser setup: create a unique random password with: openssl rand -hex 32
# Login username is admin. Keep this value masked and independent of GitHub credentials.
GITHUB_SETUP_PASSWORD=
# Everything else needed for GitHub/Spaces is entered in the protected setup page.
# Setup defaults: Spaces region=fra1, root folder=github-backup.
# OPTIONAL: scheduler, retention, capacity and monitoring defaults.
BACKUP_INTERVAL_HOURS=1
# Recent changed versions plus older UTC calendar checkpoints; deduplicated.
BACKUP_RETENTION=3
BACKUP_KEEP_WEEKLY=2
BACKUP_KEEP_MONTHLY=2
BACKUP_KEEP_OLDEST=true
# 0 disables the age floor to keep the above count policy bounded.
BACKUP_MIN_AGE_DAYS=0
BACKUP_MANIFEST_RETENTION=14
# Budget counts only live objects inside the configured backup root, not the shared bucket.
BACKUP_MAX_STORAGE_GIB=100
BACKUP_WORKERS=1
BACKUP_TIMEOUT_HOURS=12
BACKUP_CPUS=0.5
BACKUP_MEMORY_LIMIT=512m
# Optional comma-separated numeric IDs of intentionally deleted repos; never purges data.
ACKNOWLEDGED_MISSING_REPOSITORIES=

# OPTIONAL: disabled when empty. Copy a Push monitor's secret URL from Uptime Kuma.
UPTIME_KUMA_PUSH_URL=
# Enable only for Kuma reached over a trusted private HTTP network.
UPTIME_KUMA_ALLOW_HTTP=false
UPTIME_KUMA_TIMEOUT_SECONDS=5
# 0 = automatic: 2 * BACKUP_INTERVAL_HOURS + 1 (3 hours with default hourly checks).
UPTIME_KUMA_MAX_SUCCESS_AGE_HOURS=0

# OPTIONAL manual alternative: leave all three empty for browser setup.
# GitHub App General > App ID; install on All repositories for each listed login.
# Private keys > Generate a private key; base64 < app-private-key.pem | tr -d '\n'
# Manual settings take precedence over saved browser credentials; use one mode.
GITHUB_APP_ID=
GITHUB_APP_OWNERS=
GITHUB_APP_PRIVATE_KEY_BASE64=

# OPTIONAL legacy Spaces environment alternative (saved browser settings take precedence).
# DigitalOcean > Spaces Object Storage > Access Keys: access key ID and matching secret.
# These boto3 variable names take DigitalOcean credentials, not AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DigitalOcean > Spaces > Buckets: bucket name alone and its origin region slug.
SPACES_BUCKET=
SPACES_REGION=fra1
SPACES_PREFIX=github-backup
